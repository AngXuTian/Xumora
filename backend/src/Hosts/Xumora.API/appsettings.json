{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] CorrelationId={CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "None",
    "Model": "",
    "ApiKey": "",
    "Endpoint": ""
  },
  "Storage": {
    "Provider": "Local",
    "BucketName": "xumora-photos",
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Jwt": {
    "Issuer": "Xumora",
    "Audience": "Xumora.Mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshTokenAbsoluteDays": 90
  },
  "Google": {
    "WebClientId": ""
  }
}
